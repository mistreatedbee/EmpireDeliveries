{
  "name": "empire-deliveries-mobile",
  "version": "1.0.9",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android:mobile": "npx expo prebuild --no-install --platform android",
    "fix:agp": "node ./scripts/fix-agp.js",
    "typecheck": "tsc --noEmit",
    "build:android:internal": "eas build --platform android --profile internal --non-interactive",
    "submit:android:internal": "eas submit --platform android --profile internal --latest",
    "eas-build-post-install": "node ./scripts/inject-google-services.js && node ./scripts/diagnose-autolinking.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
