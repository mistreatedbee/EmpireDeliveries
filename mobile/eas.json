{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EAS_PROJECT_ID": "9ef1f2ef-eb72-4aac-b9a5-342f0fdff1a6",
        "EAS_PROJECT_SLUG": "emp"
      }
    },
    "production": {
      "autoIncrement": false,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EAS_PROJECT_ID": "9ef1f2ef-eb72-4aac-b9a5-342f0fdff1a6",
        "EAS_PROJECT_SLUG": "emp"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
